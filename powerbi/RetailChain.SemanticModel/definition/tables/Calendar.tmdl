table Calendar
	lineageTag: ab0eb3b8-8854-44c4-9aa9-ee3455cb0810
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: dd.MM.yyyy
		lineageTag: dd4c659f-0926-4ba9-a3e7-b1ecdc57afe0
		summarizeBy: none
		sourceColumn: [Date]

	column İl = YEAR('Calendar'[Date])
		dataType: int64
		formatString: 0
		lineageTag: 03899928-fe55-4814-b46e-5ad91fbe9dee
		summarizeBy: none

	column AyNo = MONTH('Calendar'[Date])
		dataType: int64
		formatString: 0
		lineageTag: 57fbc7b1-9aa3-4c7a-94ca-a6b87257ff53
		summarizeBy: none

	column Ay = SWITCH('Calendar'[AyNo],1,"Yanvar",2,"Fevral",3,"Mart",4,"Aprel",5,"May",6,"İyun",7,"İyul",8,"Avqust",9,"Sentyabr",10,"Oktyabr",11,"Noyabr",12,"Dekabr")
		dataType: string
		lineageTag: 62f69a2c-f921-404b-8475-c395b63bef6e
		summarizeBy: none
		sortByColumn: AyNo

	column İlAy_sıra = YEAR('Calendar'[Date]) * 100 + MONTH('Calendar'[Date])
		dataType: int64
		formatString: 0
		lineageTag: 6e0759f2-1a58-4f1d-a6b9-17bdb1d47d59
		summarizeBy: none

	column İlAy = FORMAT('Calendar'[Date], "yyyy-MM")
		dataType: string
		lineageTag: e553ee11-5e59-4a8b-9b83-763ee282dc15
		summarizeBy: none
		sortByColumn: İlAy_sıra

	column 'Ay başlanğıcı' = DATE(YEAR('Calendar'[Date]), MONTH('Calendar'[Date]), 1)
		dataType: dateTime
		formatString: MMM yy
		lineageTag: 9dc53e4d-f36d-4d08-b81d-939019cf4cdc
		summarizeBy: none

	column 'İl (mətn)' = FORMAT('Calendar'[Date], "yyyy")
		dataType: string
		lineageTag: 3bb001ce-785e-48b6-b3ba-9596ce530e61
		summarizeBy: none
		sortByColumn: İl

	partition Calendar = calculated
		mode: import
		source = CALENDAR(DATE(2022,1,1), DATE(2025,9,30))

